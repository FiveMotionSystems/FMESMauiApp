  <!-- Windows 用の AppxBundle 出力を有効化 -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-windows10.0.19041.0'">
    <!-- Always で .msixbundle を作成 -->
    <AppxBundle>Always</AppxBundle>
    <!-- 作成するアーキテクチャを指定（必要なら x86 を追加） -->
    <AppxBundlePlatforms>x64;arm64</AppxBundlePlatforms>
    <!-- 出力先（任意） -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\windows</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-maccatalyst' and '$(Platform)'=='x64'">
    <!-- x64 ビルド時は maccatalyst-x64 を使う -->
    <RuntimeIdentifier>maccatalyst-x64</RuntimeIdentifier>
  </PropertyGroup>

