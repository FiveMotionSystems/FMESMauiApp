<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>FMESSignage</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>FMES_Signage</ApplicationTitle>
    <Title>FMES_Signage</Title>

    <!-- App Identifier -->
    <ApplicationId>com.companyname.fmessignage</ApplicationId>
  </PropertyGroup>

  <PropertyGroup>
    <AndroidCompileSdkVersion>36</AndroidCompileSdkVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <AndroidMinSdkVersion>21</AndroidMinSdkVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiXaml Include="**\*.xaml" />
    <MauiImage Include="Resources\Images\**" />
    <MauiFont Include="Resources\Fonts\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Images\signage.png" Color="#512BD4" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.xaml.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="**\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Include="Resources\Images\**\*.png" />
    <MauiAsset Include="Resources\Images\**\*.jpg" />
    <MauiAsset Include="Resources\Images\**\*.jpeg" />
    <MauiAsset Include="Resources\Images\**\*.gif" />
  </ItemGroup>

  <ItemGroup>
    <MauiSplashScreen Include="Resources\Splash\**\*.png" />
  </ItemGroup>

</Project>